        },
        "CodeSha256": "WfOYJrKm/rRsR70XUdHE72QTNaoPHr4j45cwZKvCoDI="
      }
    },
    "SyncWorkerLambdaVersionONq5T0uWHxOz9z1fh1xsbD4w2wycIZtdij9EoU5E": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "SyncWorkerLambdaFunction"
        },
        "CodeSha256": "WfOYJrKm/rRsR70XUdHE72QTNaoPHr4j45cwZKvCoDI="
      }
    },
    "SyncWorkerEventSourceMappingSQSSyncQueue": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "DependsOn": [
        "SyncLambdaRole"
      ],
      "Properties": {
        "BatchSize": 10,
        "MaximumBatchingWindowInSeconds": 20,
        "EventSourceArn": {
          "Fn::GetAtt": [
            "SyncQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Fn::GetAtt": [
            "SyncWorkerLambdaFunction",
            "Arn"
          ]
        },
        "Enabled": true,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "ScalingConfig": {
          "MaximumConcurrency": 2
        }
      }
    },
    "SourceBucket": {
      "Type": "AWS::S3::Bucket",
      "DependsOn": [
        "SyncQueuePolicy"
      ],
      "Properties": {
        "BucketName": "poocho-ai-dev-source-634003055246",
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedOrigins": {
                "Fn::Split": [
                  ",",
                  "*"
                ]
              },
              "AllowedMethods": [
                "PUT",
                "GET",
                "HEAD"
              ],
              "AllowedHeaders": [
                "*"
              ],
              "ExposedHeaders": [
                "ETag"
              ],
              "MaxAge": 3000
            }
          ]
        },
        "NotificationConfiguration": {
          "QueueConfigurations": [
            {
              "Event": "s3:ObjectCreated:*",
              "Queue": {
                "Fn::GetAtt": [
                  "SyncQueue",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "uploads/"
                    },
                    {
                      "Name": "suffix",
                      "Value": ".pdf"
                    }
                  ]
                }
              }
            },
            {
              "Event": "s3:ObjectCreated:*",
              "Queue": {
                "Fn::GetAtt": [
                  "SyncQueue",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "uploads/"
                    },
                    {
                      "Name": "suffix",
                      "Value": ".docx"
                    }
                  ]
                }
              }
            },
            {
              "Event": "s3:ObjectCreated:*",
              "Queue": {
                "Fn::GetAtt": [
                  "SyncQueue",
                  "Arn"
                ]
              },
              "Filter": {
                "S3Key": {
                  "Rules": [
                    {
                      "Name": "prefix",
                      "Value": "uploads/"
                    },
                    {
                      "Name": "suffix",
                      "Value": ".txt"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "SyncDLQ": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "poocho-ai-dev-sync-dlq",
        "MessageRetentionPeriod": 1209600
      }
    },
    "SyncQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "poocho-ai-dev-sync",
        "VisibilityTimeout": 180,
        "MessageRetentionPeriod": 345600,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "SyncDLQ",
              "Arn"
            ]
          },
          "maxReceiveCount": 15
        }
      }
    },
    "SyncQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "SyncQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowS3SendMessage",
              "Effect": "Allow",
              "Principal": {
                "Service": "s3.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "SyncQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:s3:::poocho-ai-dev-source-634003055246"
                },
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "VectorBucket": {
      "Type": "AWS::S3Vectors::VectorBucket",
      "Properties": {
        "VectorBucketName": "poocho-ai-dev-vectors-634003055246"
      }
    },
    "VectorIndex": {
      "Type": "AWS::S3Vectors::Index",
      "DependsOn": [
        "VectorBucket"
      ],
      "Properties": {
        "VectorBucketName": "poocho-ai-dev-vectors-634003055246",
        "IndexName": "poocho-ai-index",
        "DataType": "float32",
        "Dimension": 1024,
        "DistanceMetric": "cosine",
        "MetadataConfiguration": {
          "NonFilterableMetadataKeys": [
            "AMAZON_BEDROCK_TEXT",
            "AMAZON_BEDROCK_METADATA"
          ]
        }
      }
    },
    "KnowledgeBaseRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "poocho-ai-dev-kb-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:aws:bedrock:${AWS::Region}:${AWS::AccountId}:knowledge-base/*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "kb-access",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "EmbeddingModel",
                  "Effect": "Allow",
                  "Action": "bedrock:InvokeModel",
                  "Resource": "arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0"
                },
                {
                  "Sid": "ReadSourceBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    "arn:aws:s3:::poocho-ai-dev-source-634003055246",
                    "arn:aws:s3:::poocho-ai-dev-source-634003055246/*"
                  ],
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceAccount": {
                        "Ref": "AWS::AccountId"
                      }
                    }
                  }
                },
                {
                  "Sid": "VectorStore",
                  "Effect": "Allow",
                  "Action": [
                    "s3vectors:GetIndex",
                    "s3vectors:QueryVectors",
                    "s3vectors:PutVectors",
                    "s3vectors:GetVectors",
                    "s3vectors:DeleteVectors",
                    "s3vectors:ListVectors"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "VectorIndex",
                      "IndexArn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "KnowledgeBase": {
      "Type": "AWS::Bedrock::KnowledgeBase",
      "DependsOn": [
        "KnowledgeBaseRole",
        "VectorIndex"
      ],
      "Properties": {
        "Name": "poocho-ai-dev-kb",
        "Description": "Per-student study documents for Poocho AI",
        "RoleArn": {
          "Fn::GetAtt": [
            "KnowledgeBaseRole",
            "Arn"
          ]
        },
        "KnowledgeBaseConfiguration": {
          "Type": "VECTOR",
