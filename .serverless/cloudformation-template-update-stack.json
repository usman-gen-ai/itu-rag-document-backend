                    "bedrock:ListKnowledgeBaseDocuments",
                    "bedrock:ListIngestionJobs",
                    "bedrock:GetIngestionJob"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "KnowledgeBase",
                      "KnowledgeBaseArn"
                    ]
                  }
                },
                {
                  "Sid": "GenerationModel",
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel",
                    "bedrock:GetInferenceProfile"
                  ],
                  "Resource": [
                    "arn:aws:bedrock:*::foundation-model/*",
                    {
                      "Fn::Sub": "arn:aws:bedrock:*:${AWS::AccountId}:inference-profile/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "SyncLambdaRole": {
