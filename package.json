{
  "name": "poocho-ai-backend",
  "version": "1.0.0",
  "description": "Poocho AI - serverless study assistant backend (Express + Bedrock Knowledge Base + S3 Vectors)",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "info": "serverless info",
    "logs:api": "serverless logs -f api -t",
    "logs:sync": "serverless logs -f syncWorker -t"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.730.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.730.0",
    "@aws-sdk/client-s3": "^3.730.0",
    "@aws-sdk/client-sqs": "^3.730.0",
    "@aws-sdk/s3-request-presigner": "^3.730.0",
    "express": "^4.21.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "serverless": "^3.40.0"
  }
}
